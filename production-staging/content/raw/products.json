    "status": "concept",
    "display_order": 6,
    "is_visible": true,
    "data": {
      "name": "Wasted Real-Estate",
      "category": "earbud",
      "tagline": "Why are AirPod cases filled with plastic? Look at the physical volume when closed — not a whole lot different from a small iPhone. What if the case itself was the point, and the earbuds were an exponentially lower-power byproduct?",
      "description": "Originally concepted at Dolby. Apple shut it down — threatened to pull Dolby's licensing if the headphone program continued. The opportunity is back. Vetted, feasibility-positive, cost-positive, market-positive, channel-probe-positive.",
      "form_factor": {
        "finish": "Case-as-product premium materials",
        "materials": [
          "machined alloy case",
          "precision-fit earbud byproduct"
        ]
      },
      "audio": {
